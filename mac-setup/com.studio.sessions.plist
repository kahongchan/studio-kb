<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- factory 登入 macOS 時執行 start-sessions.sh。放在 /Users/factory/Library/LaunchAgents/ -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.studio.sessions</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/factory/studio/bin/start-sessions.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <!-- 每 10 分鐘檢查一次，視窗關了會重開 -->
  <key>StartInterval</key>
  <integer>600</integer>
  <key>StandardOutPath</key>
  <string>/Users/factory/studio/logs/sessions.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/factory/studio/logs/sessions.log</string>
</dict>
</plist>
